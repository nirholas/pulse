{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pulse",
  "main": "dist/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "9b69258d55b0dc7ed0c31c067dd944d8",
  "assets": { "directory": "../dist/web", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "pulse", "database_id": "053c1ce8-24da-41ab-acb5-baae995ee7b7", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "pulse-archive" }],
  "durable_objects": { "bindings": [{ "name": "FIREHOSE", "class_name": "Firehose" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Firehose"] }, { "tag": "v2", "deleted_classes": ["Firehose"] }, { "tag": "v3", "new_sqlite_classes": ["Firehose"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "SOLANA_WS_URLS": "wss://solana-rpc.publicnode.com,wss://api.mainnet-beta.solana.com", "SOLANA_RPC_URLS": "https://solana-rpc.publicnode.com,https://api.mainnet-beta.solana.com", "REPORT_TIMEZONE": "UTC" },
  "observability": { "enabled": true }
}
