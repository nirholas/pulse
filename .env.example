# Leave DATABASE_URL empty to use the embedded PGlite archive in data/pglite.
# With `npm run db:up`: postgres://pulse:pulse@localhost:5544/pulse
DATABASE_URL=
PORT=8787
PUBLIC_URL=

# Newsletter
REPORT_TIMEZONE=UTC
REPORT_HOUR=13
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: adds a written overview constrained to the day's data
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Collection
SNAPSHOT_EVERY_MIN=5
STREAMS=on
# Comma separated. Public endpoints work but a dedicated RPC keeps the firehose stable.
SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com
SOLANA_WS_URLS=wss://api.mainnet-beta.solana.com
ROBINHOOD_RPC_URLS=https://rpc.mainnet.chain.robinhood.com

# Git archive: every UTC day is exported to compressed JSONL, a runners digest
# and an AI brief, then committed to this repo so the history is permanent.
# Create it once: gh repo create <you>/pulse-data --private
ARCHIVE_REPO=
# A token with contents:write on that repo (falls back to GITHUB_TOKEN)
ARCHIVE_TOKEN=
ARCHIVE_DIR=data/archive
ARCHIVE_BRANCH=main
# On first run, how far back to export when the database holds older data
ARCHIVE_BACKFILL_DAYS=30
